[Unit]
Description=QRipple real-time QR code sharing
After=network-online.target tailscaled.service
Wants=network-online.target
# Keep retrying: at boot a Tailscale listen address may not exist yet.
StartLimitIntervalSec=0

[Service]
Type=simple
User=qripple
Group=qripple
WorkingDirectory=/opt/qripple/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# The reverse proxy in front appends the client address to X-Forwarded-For.
Environment=TRUST_PROXY=1
# Per-node settings (listen addresses, access lines, ...) override the above.
EnvironmentFile=-/etc/qripple/qripple.env
ExecStart=/opt/qripple/node/bin/node server/index.js
Restart=always
RestartSec=2

# Sandboxing: the app only needs to read its own files and open sockets.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
